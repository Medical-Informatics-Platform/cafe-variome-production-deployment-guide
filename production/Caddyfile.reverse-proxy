# TLS front-end for CV3. Terminates HTTPS for ${CV_PUBLIC_HOST} and path-routes to
# the frontend + backend services. Caddy obtains/renews the cert automatically
# (egress is forced through cv-tls-egress-proxy - see compose.reverse-proxy.yml).
#
# Public routes mirror the upstream Apache vhost:
#   /            -> frontend (SPA, /discover, /meta-discover, /callback*.html, assets)
#   /api         -> admin backend     (:5000)   [prefix stripped]
#   /query       -> query backend     (:5100)   [prefix stripped]
#   /federation  -> network backend   (:5200)   [prefix stripped]
#   /auth        -> Keycloak          (:8080)   [local-infra only]

{
	# Force IPv4-only TCP listeners. Rootless Docker forwards ports with pasta in
	# --ipv4-only mode, which only forwards container listeners bound on IPv4. Plain
	# `0.0.0.0` still leaves Caddy on a dual-stack [::] socket (shows under tcp6), which
	# pasta won't forward - so the published 80/443 never reach the host. The `tcp4/`
	# network prefix makes Go open an AF_INET socket that pasta forwards.
	default_bind tcp4/0.0.0.0
	acme_ca {$CV_ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
}

{$CV_PUBLIC_HOST} {
	# email -> public Let's Encrypt (needs inbound 80/443); "internal" -> Caddy CA.
	tls {$CV_TLS:admin@example.com}
	encode zstd gzip

	# Security response headers. Applied at the single TLS edge so every route gets
	# them (SPA, APIs and Keycloak alike) without touching the upstream images.
	header {
		# HSTS: 1 year. Only meaningful on a real domain over public TLS; harmless on
		# a `tls internal` test box because browsers ignore it for untrusted certs.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# The SPA is not meant to be framed; Keycloak's own login page sets its
		# frame-ancestors CSP, and SAMEORIGIN keeps its iframe-based session checks
		# (silent SSO via callback-silent.html) working.
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Drop browser access to hardware/APIs the app does not use.
		Permissions-Policy "geolocation=(), microphone=(), camera=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Do not advertise the server/framework.
		-Server
		-X-Powered-By
	}

	# NOTE: no Content-Security-Policy here on purpose. The CV3 SPA's inline/eval
	# usage is not audited, and a wrong CSP breaks the app silently in the browser
	# rather than failing loudly at deploy. Add one after testing the real bundle:
	#   header Content-Security-Policy "default-src 'self'; ..."

	# ACCESS LOG: one structured JSON line
	# per request (timestamp, client IP, method, URI, status, user agent) to stdout
	# -> the journald logging driver -> the host's persistent journal (1-year
	# retention, survives redeploys/reboots; see deploy/journald-cv3.conf). Query:
	#   sudo journalctl CONTAINER_NAME=cv-proxy --since "2026-01-01" | grep '"uri"'
	log {
		output stdout
		format json
	}

	# Backend APIs. The public prefix is stripped so the backend sees the request at
	# root, matching the upstream Apache `ProxyPass /api http://:5000`. The bare path
	# (/api, no slash) must match too: CV3's network backend checks "{url}/api" to
	# decide whether its own installation is reachable.
	@api path /api /api/*
	handle @api {
		uri strip_prefix /api
		reverse_proxy cv3-backend-admin:5000
	}
	@query path /query /query/*
	handle @query {
		uri strip_prefix /query
		reverse_proxy cv3-backend-query:5100
	}
	@federation path /federation /federation/*
	handle @federation {
		uri strip_prefix /federation
		reverse_proxy cv3-backend-network:5200
	}

	# Keycloak - only reachable when the local-infra overlay runs it; configure that
	# Keycloak with KC_HTTP_RELATIVE_PATH=/auth (see compose.local-infra.yml). For an
	# EXTERNAL Keycloak, delete this block and set backend_config.json Keycloak.URL +
	# the frontend redirect URLs to the external host.
	handle /auth/* {
		# Keycloak hardening: the ADMIN console/API (/auth/admin) and the master
		# realm are not for end users - never expose them on the public edge. The
		# app only needs the cafe_variome realm's OIDC endpoints; the db-manager
		# talks to Keycloak in-cluster (BackendURL), unaffected by this block.
		# Admin access without public exposure (rootless: the host cannot reach
		# container IPs, so plain ssh -L to the container won't work):
		#   - CLI: docker exec cv3-keycloak /opt/keycloak/bin/kcadm.sh ... (see bootstrap)
		#   - GUI, on demand: publish loopback-only, then tunnel to it -
		#       docker run --rm -d --name kc-tunnel --network production_cv_edge \
		#         -p 127.0.0.1:8081:8080 alpine/socat tcp-listen:8080,fork,reuseaddr tcp:cv3-keycloak:8080
		#       ssh -L 8081:127.0.0.1:8081 <admin>@<host>  ->  http://localhost:8081/auth/admin/
		#       docker rm -f kc-tunnel   # when done
		# Exception for federation with a shared Keycloak (FEDERATION.md): peer
		# installations listed in CV_KC_ADMIN_PEERS may call this realm's admin REST
		# API (their db-manager and admin backend manage their users here). The
		# console and the master realm stay blocked for everyone.
		@kc_admin {
			path /auth/admin* /auth/realms/master/*
			not {
				path /auth/admin/realms/cafe_variome/*
				remote_ip {$CV_KC_ADMIN_PEERS:192.0.2.1/32}
			}
		}
		respond @kc_admin 403
		reverse_proxy cv3-keycloak:8080
	}

	# Everything else -> the SPA frontend (Caddy auto-sets X-Forwarded-* upstream).
	handle {
		reverse_proxy cv3-frontend:80
	}
}
