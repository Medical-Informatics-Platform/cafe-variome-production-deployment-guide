# CV3 production environment - copy to `.env`, replace every CHANGE_ME, then run
#   ./scripts/validate-env.sh
# `.env` is gitignored. Generate strong values with: openssl rand -hex 32
# cv.sh reads CV_PUBLIC_HOST / CV_LOCAL_INFRA from here so overlays persist.

# --- Vault AppRole (runtime secrets; required) ------------------------------
# Populated by scripts/bootstrap_local_infra.sh in local-infra mode, or issued by your
# external Vault in production.
VAULT_ROLE_ID=CHANGE_ME
VAULT_SECRET_ID=CHANGE_ME

# --- Bootstrap-only (first run; may be blanked afterwards) ------------------
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
ADMIN_EMAIL=admin@example.org
ADMIN_AFFILIATION=CHANGE_ME

# --- Worker tuning ----------------------------------------------------------
DB_MANAGER_WORKER=2
META_QUERY_WORKER=2

# --- Deployment toggles (read by cv.sh) -------------------------------------
# Public hostname for the TLS reverse proxy (e.g. cafevariome.example.org, or
# <ip>.sslip.io for a no-domain test box). Set to enable HTTPS ingress.
CV_PUBLIC_HOST=
# Let's Encrypt account email (required when CV_PUBLIC_HOST is set).
ACME_EMAIL=CHANGE_ME
# 1 = run Keycloak + Vault + MongoDB locally (self-contained, single-host / test).
# unset/0 = use EXTERNAL Keycloak/Vault/Mongo (recommended production).
CV_LOCAL_INFRA=

# --- Local-infra secrets (required only when CV_LOCAL_INFRA=1) --------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# Keycloak's own Postgres (cv3-keycloak-postgres):
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=CHANGE_ME
MONGO_ROOT_USERNAME=cv3root
MONGO_ROOT_PASSWORD=CHANGE_ME
MONGO_APP_USERNAME=cv3app
MONGO_APP_PASSWORD=CHANGE_ME
# Vault (local-infra) runs in NON-dev mode; it is initialised + unsealed by the
# bootstrap step, which writes unseal/recovery keys to a gitignored file you must
# move offline. There is no auto-unseal here - see SECURITY.md / README § Production.

# --- Logging ----------------------------------------------------------------
# Container logs go to the host systemd journal (journald driver; survives container
# recreation and reboots, retained 1 year - see deploy/journald-cv3.conf and
# SECURITY.md § Logging). Nothing to configure here; query with:
#   sudo journalctl CONTAINER_NAME=<name> --since "..." --until "..."
