Vagrant.configure("2") do |config|
  config.vm.box = "bento/debian-13"
  config.vm.box_version = "202510.26.0"
  config.vm.box_architecture = "arm64"
  config.vm.hostname = "bento-debian13"

  # Keep startup friction low on macOS.
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.network "forwarded_port", guest: 5080, host: 5080, auto_correct: true
  config.vm.network "forwarded_port", guest: 5000, host: 5000, auto_correct: true
  config.vm.network "forwarded_port", guest: 5100, host: 5100, auto_correct: true
  config.vm.network "forwarded_port", guest: 5200, host: 5200, auto_correct: true
  config.vm.network "forwarded_port", guest: 5300, host: 5300, auto_correct: true
  config.vm.network "forwarded_port", guest: 8080, host: 8080, auto_correct: true

  config.vm.provider "virtualbox" do |vb|
    vb.name = "linux-server-management_bento_debian13"
    vb.memory = 4096
    vb.cpus = 2
    vb.gui = false
  end
end
